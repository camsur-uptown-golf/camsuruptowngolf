# Para sa EAS Build ng Expo app (`mobile/`): repo root ang ina-upload ng EAS,
# kaya ang `mobile/` at ang content ng website na binabasa nito (`src/lib/`)
# (at `src/i18n/`) lang ang isinasama — hindi ang ~1 GB na website.
/*
!/mobile
!/src
/src/*
!/src/lib
!/src/i18n
**/node_modules
/mobile/.expo
/mobile/dist
/mobile/ios
/mobile/android
