# Kopyahin bilang .env.local at punan. Hindi kailanman i-commit ang .env.local.

# Buong URL ng site, walang "/" sa dulo. Ito ang batayan ng redirect URI ng
# Google/Apple. Sa localhost ay puwedeng iwanang blangko.
SITE_URL=

# ── Continue with Google ──────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
#   https://<domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Continue with Apple ───────────────────────────────────────────────────────
# Apple Developer → Certificates, Identifiers & Profiles:
#   - Services ID (ito ang APPLE_CLIENT_ID), naka-enable ang "Sign in with Apple"
#     na may Return URL: https://<domain>/api/auth/apple/callback
#     (HTTPS lang — hindi gumagana ang Apple sa localhost)
#   - Key na may "Sign in with Apple" → i-download ang .p8 (APPLE_PRIVATE_KEY),
#     at ang Key ID nito (APPLE_KEY_ID)
#   - Team ID ng account (APPLE_TEAM_ID)
# Ang laman ng .p8 ay ilagay sa isang linya, \n ang kapalit ng bawat newline.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
